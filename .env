# ==============================================================================
# ContextRelay Environment Configuration (.env)
# ==============================================================================

# 1. Hindsight Service Endpoint
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

# 2. Application LLM Provider
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# 3. Application Metadata Storage (SQLite)
# Automatically uses /tmp/context-relay.db when deployed on Vercel
DATABASE_PATH=./context-relay.db

# Hindsight Memory Service Configuration
HINDSIGHT_API_URL=http://localhost:8888
# Optional: Set if your Hindsight instance requires an API token / bearer token
HINDSIGHT_API_KEY=

# Application LLM Provider Configuration
# Supported providers: groq (recommended for speed), openai, anthropic, gemini
LLM_PROVIDER=groq

# Provider API Keys (fill the one matching your LLM_PROVIDER)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (optional, defaults provided per provider)
# For groq: llama-3.3-70b-versatile
# For openai: gpt-4o-mini
# For anthropic: claude-3-5-haiku-latest
# For gemini: gemini-2.0-flash
LLM_MODEL=llama-3.3-70b-versatile

# Application SQLite Database File Path (optional)
DATABASE_PATH=./context_relay.sqlite
